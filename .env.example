# ── Databricks workspace ──────────────────────────────────────────────────────
# Workspace URL, no trailing slash. e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=https://dbc-927300a1-adc8.cloud.databricks.com

# A Databricks Personal Access Token (User Settings → Developer → Access tokens),
# or a Service Principal OAuth token. Needs: jobs run + Files API read on the output Volume.
DATABRICKS_TOKEN=dapif290911094b2f54c70c9b34ca37958f5

# The numeric Job ID of the Control-M Analyzer job (see databricks-job.json / README).
DATABRICKS_JOB_ID=71177173711632

# Output Volume folder the notebook writes the .xlsx into (must match CONFIG.output_volume).
OUTPUT_VOLUME=/Volumes/edl_qa/qa_agent/control_m

# Optional: simple shared password to gate the UI (leave blank to disable the gate).
APP_PASSWORD=
