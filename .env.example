# ── Databricks workspace ──────────────────────────────────────────────────────
# Workspace URL, no trailing slash. e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=https://dbc-927300a1-adc8.cloud.databricks.com

# A Databricks Personal Access Token (User Settings → Developer → Access tokens),
# or a Service Principal OAuth token. Needs: jobs run + Files API read on the output Volume.
DATABRICKS_TOKEN=dapif290911094b2f54c70c9b34ca37958f5

# The numeric Job ID of the Control-M Analyzer job (see databricks-job.json / README).
DATABRICKS_JOB_ID=71177173711632

# Output Volume folder the notebook writes the .xlsx into (must match CONFIG.output_volume).
OUTPUT_VOLUME=/Volumes/edl_qa/qa_agent/control_m

# Input Volume folder the notebook READS the workspace XML from (must match CONFIG.xml_folder).
# Uploads from the website land here. Leave blank to reuse OUTPUT_VOLUME.
INPUT_VOLUME=/Volumes/edl_qa/qa_agent/control_m

# Optional: simple shared password to gate the UI (leave blank to disable the gate).
APP_PASSWORD=

# ── Leave Request module ──────────────────────────────────────────────────────
# Databricks SQL Warehouse used to store leave data (Delta tables via the SQL API).
# Warehouse ID = the last segment of the SQL Warehouse "HTTP path"
# (/sql/1.0/warehouses/<id>). Non-secret identifier.
DATABRICKS_WAREHOUSE_ID=638494b8211390ee
# Catalog/schema where the leave_* Delta tables are created (defaults edl_qa/qa_agent).
LEAVE_CATALOG=edl_qa
LEAVE_SCHEMA=qa_agent
# Secret used to sign the leave session cookie (set a long random string).
AUTH_SECRET=
# Initial admin password seeded on first run (username is "admin"). Change it after.
LEAVE_ADMIN_PASSWORD=admin@123
# Email notifications (optional) — Resend API key + From address.
RESEND_API_KEY=
LEAVE_FROM_EMAIL=Leave Tracker <onboarding@resend.dev>

# ── DG Document Creation ──────────────────────────────────────────────────────
# Catalog tables/DG docs live in (fixed in the UI). Step 1 creates schemas/tables
# here via the SQL Warehouse; step 2 triggers the DG job below.
DG_CATALOG=edl_qa
# Volume the uploaded table-template .xlsx is copied into (defaults to INPUT_VOLUME).
DG_INPUT_VOLUME=
# Numeric Job ID of the DG Document Creation Databricks job (DG_DOCUMENT_CREATION.py).
DG_CREATION_JOB_ID=
# Volume the DG job writes its .xlsx into (defaults to OUTPUT_VOLUME; sandboxes downloads).
DG_OUTPUT_VOLUME=
